# App
NODE_ENV=node_environment
PORT=port

# Encryption
BCRYPT_SALT_ROUNDS=salt_rounds

# Database
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password

#Auth
JWT_ACCESS_SECRET=jwt_access_token_secret
JWT_REFRESH_SECRET=jwt_refresh_token_secret
JWT_ACCESS_TOKEN_EXPIRATION_MS=jwt_access_token_expiration_time(milliseconds)
JWT_REFRESH_TOKEN_EXPIRATION_MS=jwt_refresh_token_expiration_time(milliseconds)


# Prisma
DATABASE_URL="postgresql://your_database_user:your_database_password@localhost:5432/your_database_name?schema=public"
